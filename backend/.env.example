# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cropshield?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# Redis Cloud Connection String (Optional / Resilient fallback to memory cache if omitted)
# Example: redis://default:<password>@<host>:<port>
REDIS_URL=your_redis_cloud_connection_url

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_google_gemini_api_key

# Frontend Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173
